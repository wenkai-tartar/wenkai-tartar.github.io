{% if jekyll.environment == 'production' and site.event_endpoint and site.event_endpoint != empty %}
  <script
    defer
    src="{{ '/assets/js/event-client.js' | relative_url | bust_file_cache }}"
    data-endpoint="{{ site.event_endpoint | escape }}"
    data-site-origin="{{ site.url | escape }}"
  ></script>
{% endif %}
